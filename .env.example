APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nubicta: datos iniciales (php artisan db:seed)
ERP_COMPANY_NAME="Mi empresa"
ERP_COMPANY_NIT=
# Usa true para crearla como persona natural; ERP_COMPANY_NAME pasa a ser el/los nombres.
ERP_COMPANY_IS_PERSON=false
# Apellidos (opcional para la creacion inicial como persona natural).
ERP_COMPANY_SURNAME=
# Nombre comercial; si queda vacio se usa el nombre de la empresa o nombre(s) y apellidos.
ERP_COMPANY_TRADE_NAME=
# Ciudad DANE de la empresa inicial. 11001 es Bogotá. El departamento son los dos primeros dígitos.
ERP_COMPANY_MUNICIPALITY=11001
ERP_COMPANY_DEPARTMENT=11
ERP_ADMIN_NAME=Administrador
ERP_ADMIN_EMAIL=admin@example.com

# Migración desde Siigo Nube (opcional, solo lectura): usuario y access key de la API de Siigo
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=Nubicta
SIIGO_PAUSE_MS=300
# Sincroniza cada hora desde Siigo mientras la empresa siga trabajando en los dos sistemas
SIIGO_AUTO_SYNC=false
